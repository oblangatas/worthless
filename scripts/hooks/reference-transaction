#!/bin/sh
# reference-transaction — refuse an unsigned release tag at the moment it is created.
#
# Why this exists: on 0.3.7 and again on v0.3.12, three months apart, a release tag was
# created by hand instead of by ./scripts/tag-release.sh.  Local `gpg.format` is `ssh`
# (required for commit provenance), so the bare command produced an SSH-signed tag that
# CI's verify-tag.sh refused -- costing a recut each time.  See RELEASING.md (WOR-908).
#
# Why it does NOT call `git verify-tag`: that command auto-detects signature format, and
# `gpg.ssh.allowedSignersFile` is set on this machine, so an SSH-signed tag verifies
# GOOD -- it would admit the exact failure this guards against.  A plain text check on
# the tag object is both correct here and free of any keyring dependency.
#
# This is ergonomics, not a security control.  See "What this does NOT defend against"
# in RELEASING.md.  The backstop that decides what actually ships is
# .github/scripts/verify-tag.sh, which is fingerprint-pinned and fail-closed.

# Only the "prepared" state can abort a transaction; every other state ignores our exit.
[ "$1" = "prepared" ] || exit 0

# ponytail: hardcoded on purpose.  Never derive this from local tags -- a `--no-tags`
# clone would derive an empty floor and then reject every ref it fetches.
FLOOR="v0.3.12"

# `old` is read and deliberately never used: it is all-zeros for a deletion as well as
# a creation, so it cannot identify one.  Every decision below is made from `new`.
# shellcheck disable=SC2034
while read -r old new ref; do
    case "$ref" in refs/tags/v*) ;; *) continue ;; esac

    # A deletion sends all-zeros as the NEW value.  (It sends all-zeros as `old` too,
    # so `old` cannot be used to detect a creation.)
    case "$new" in *[!0]*) ;; *) continue ;; esac

    # `git pack-refs` and `git gc` replay every existing ref as a creation.  If the ref
    # already points where this transaction wants it, nothing is being created.
    # Without this, one unsigned historical tag makes `gc` fail -- and `gc` then exits 0.
    [ "$(git rev-parse --verify --quiet "$ref" 2>/dev/null)" = "$new" ] && continue

    version="${ref#refs/tags/}"

    # Historical tags arriving by fetch.  Four tags on origin predate the signing policy
    # (v0.3.4 is lightweight; v0.3.0, v0.3.0rc1, v0.3.0rc2 are unsigned).  A rejection
    # here aborts the WHOLE transaction, so these must pass untouched.
    if [ "$version" != "$FLOOR" ] && \
       [ "$(printf '%s\n%s\n' "$FLOOR" "$version" | sort -V | head -1)" = "$version" ]; then
        continue
    fi

    logfile="$(git rev-parse --git-common-dir 2>/dev/null)/worthless-tag-guard.log"

    if [ -n "$WORTHLESS_TAG_OVERRIDE" ]; then
        printf '%s override %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ref" "$new" >>"$logfile" 2>/dev/null
        continue
    fi

    # `git cat-file tag` fails on a lightweight tag (it is a commit, not a tag object),
    # so lightweight tags fall through to the rejection below.  An SSH-signed tag says
    # BEGIN SSH SIGNATURE and is likewise rejected.
    if git cat-file tag "$new" 2>/dev/null | grep -q '^-----BEGIN PGP SIGNATURE-----$'; then
        continue
    fi

    printf '%s reject %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ref" "$new" >>"$logfile" 2>/dev/null

    echo "worthless: refusing to create $version -- it is not an OpenPGP-signed tag." >&2
    echo "" >&2
    echo "  Release tags are cut by the release script, which signs with the right key" >&2
    echo "  and runs the checks CI expects:" >&2
    echo "" >&2
    echo "      ./scripts/tag-release.sh ${version#v} \"<headline>\"" >&2
    echo "" >&2
    echo "  Recovery and override are documented in RELEASING.md." >&2
    exit 1
done

exit 0
